[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true
	default = simple

[core]
	editor = code --wait
	autocrlf = input

[diff]
	algorithm = histogram
	colorMoved = plain

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

# Work identity is the default (primary).
[user]
	name = Rafael Sá
	email = rafael.sa@olx.com

# Personal identity for personal clones only (see ~/.gitconfig-personal).
# Keep work repos outside these paths so they inherit the work email above.
[includeIf "gitdir:~/Projects/personal/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/Projects/mac-setup/"]
	path = ~/.gitconfig-personal
